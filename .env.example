# Environment alternative to Streamlit Secrets. Never commit real values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=system
APP_SECRET_KEY=
ADMIN_PHONE=
ADMIN_INITIAL_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Full PEM with real newlines if not using repository certs/supabase-ca.crt.
SUPABASE_CA_CERT=
