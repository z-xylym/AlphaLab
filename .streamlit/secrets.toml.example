DATABASE_URL = "postgresql+psycopg://postgres.PROJECT:PERCENT_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=system"
APP_SECRET_KEY = "REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
ADMIN_PHONE = "YOUR_MAINLAND_PHONE"
ADMIN_INITIAL_PASSWORD = "REPLACE_WITH_UNIQUE_12_PLUS_CHAR_PASSWORD"
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"
DAILY_CALLS = 30
PLATFORM_DAILY_CALLS = 300
DAILY_BUDGET = "20"
# CNY / million tokens; update against your actual model pricing before use.
INPUT_PRICE = "2"
OUTPUT_PRICE = "3"
SESSION_HOURS = 12
# Runtime CA: repository certs/supabase-ca.crt takes precedence.
# Otherwise replace the empty value with the full official PEM in a TOML triple-quoted string.
# See docs/RUNTIME_DEPLOYMENT.md. Never commit real Secrets.
SUPABASE_CA_CERT = ""
